MODE=development
SECRET_KEY=INSECURE-change-me
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
BOOTSTRAP_ADMIN_EMAILS=
LOGFIRE_TOKEN=
LOGFIRE_ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_REQUEST_BODY_SIZE=1048576
AUTH_RATE_LIMIT=5/minute
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false
ABSOLUTE_SESSION_EXPIRE_DAYS=30
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=bantr-debate
LIVEKIT_FORCE_RELAY=true
LIVEKIT_CONNECT_TIMEOUT_SECONDS=15
OPENAI_API_KEY=
OPENAI_COMPLEX_MODEL=openai:gpt-5.1
OPENAI_SIMPLE_MODEL=openai:gpt-5-mini
LIVEKIT_LLM_MODEL=openai/gpt-5.1
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
OPENAI_EMBED_MODEL=text-embedding-3-small
DEBATE_STALE_AFTER_SECONDS=180
DEBATE_RECONCILE_INTERVAL_SECONDS=30

